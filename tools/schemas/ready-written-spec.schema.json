{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "prompt_text", "passage_mode", "passage_text", "task_text", "targets", "conditions", "word_bank", "response_slots", "answer_template", "summary_text", "confidence", "issues"],
  "properties": {
    "kind": { "enum": ["sentence", "sentence-cloze", "arrangement", "correction", "multi-correction", "summary"] },
    "prompt_text": { "type": "string", "minLength": 1 },
    "passage_mode": { "enum": ["canonical_excerpt", "authored_variant"] },
    "passage_text": { "type": "string", "minLength": 1 },
    "task_text": { "type": "string" },
    "targets": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "text", "canonical_text"],
        "properties": {
          "label": { "type": "string" },
          "text": { "type": "string" },
          "canonical_text": { "type": "string" }
        }
      }
    },
    "conditions": { "type": "array", "maxItems": 20, "items": { "type": "string" } },
    "word_bank": { "type": "array", "maxItems": 40, "items": { "type": "string" } },
    "response_slots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "word_count"],
        "properties": {
          "label": { "type": "string" },
          "word_count": { "type": ["integer", "null"], "minimum": 1 }
        }
      }
    },
    "answer_template": {
      "type": "array",
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "text", "slot_index"],
        "properties": {
          "kind": { "enum": ["text", "slot"] },
          "text": { "type": "string" },
          "slot_index": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    },
    "summary_text": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "issues": { "type": "array", "maxItems": 20, "items": { "type": "string" } }
  }
}
