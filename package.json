{
  "name": "ready",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 4173 --directory .",
    "test:unit": "node --test tests/verify-sentence-practice.mjs",
    "test:api": "node tests/verify-ready-api.mjs",
    "test:surface": "node tests/verify-ready-surface.mjs",
    "test": "npm run test:unit && npm run test:surface && npm run test:api",
    "test:all": "npm test && npm run native:verify",
    "ready:test": "npm run test:all",
    "build": "node tools/build-pages.mjs",
    "native:build": "READY_NATIVE_BUILD=1 node tools/build-pages.mjs",
    "native:sync": "npm run native:build && cap sync",
    "native:ios": "npm run native:sync && cap open ios",
    "native:android": "npm run native:sync && cap open android",
    "native:doctor": "cap doctor",
    "native:verify": "node tests/verify-ready-native.mjs",
    "deploy:api": "npx supabase functions deploy ready --no-verify-jwt --project-ref fqvhlyocdkwiyioiokte"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@electric-sql/pglite": "0.3.14"
  }
}
